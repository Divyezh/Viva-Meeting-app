# ============================================================================
# VIVA Video Meeting - Local Development Environment Variables (.env.example)
# Copy this file to .env before starting Docker Compose or local services:
# cp .env.example .env
# ============================================================================

# ─── PostgreSQL Database (Local / Docker Compose) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viva_db
POSTGRES_PORT=5432
# In Docker Compose, the host is 'db'. Outside Docker, the host is 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viva_db

# ─── Backend Server Configuration ──────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=dev_jwt_secret_change_me_in_production_32chars

# ─── Authentication & Webhooks (Clerk) ─────────────────────────────────────
CLERK_SECRET_KEY=sk_test_placeholder_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_placeholder_clerk_webhook_secret

# ─── Payments & Subscriptions (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ─── Frontend Client Configuration (Vite) ──────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_clerk_publishable_key
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ─── WebRTC TURN Relay (Optional - leave empty for default STUN) ───────────
# VITE_TURN_SERVER_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=viva_user
# VITE_TURN_CREDENTIAL=viva_turn_secret_pass
