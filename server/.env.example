# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Clerk Secret Key (Optional - for backend token verification)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# PostgreSQL / Neon Database Connection String (Optional - in-memory fallback enabled)
DATABASE_URL=postgresql://username:password@ep-sample-pool.neon.tech/neondb?sslmode=require

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/#/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Webhook settings)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
